Ó˝const ManagerDashboard = () => {
  const [view, setView] = useState("home");
  const [managerName, setManagerName] = useState("");
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [showScrollTop, setShowScrollTop] = useState(false);

  const [averageScore, setAverageScore] = useState(0);
  const [totalUsers, setTotalUsers] = useState(0);
  const [totalAssessments, setTotalAssessments] = useState(0);
  const [recentExams, setRecentExams] = useState([]);
  const [currentPageHome, setCurrentPageHome] = useState(1);
  const [totalPagesHome, setTotalPagesHome] = useState(1);
  const [pageInputHome, setPageInputHome] = useState("1");

  const [allScores, setAllScores] = useState([]);
  const [currentScores, setCurrentScores] = useState([]);
  const [searchUser, setSearchUser] = useState("");
  const [selectedDate, setSelectedDate] = useState("");
  const [categories, setCategories] = useState([]);
  const [selectedCategories, setSelectedCategories] = useState([]);
  const [selectedStatuses, setSelectedStatuses] = useState([]);
  const [categorySearch, setCategorySearch] = useState("");
  const [showFilterModal, setShowFilterModal] = useState(false);
  const [sortColumn, setSortColumn] = useState("dateTaken");
  const [sortOrder, setSortOrder] = useState("desc");
  const [currentPageScores, setCurrentPageScores] = useState(1);
  const [totalPagesScores, setTotalPagesScores] = useState(1);
  const [pageInputScores, setPageInputScores] = useState("1");

  const [employees, setEmployees] = useState([]);
  const [employeeSearchTerm, setEmployeeSearchTerm] = useState("");
  const [selectedRole, setSelectedRole] = useState({});
  const [roles, setRoles] = useState([]);

  const [file, setFile] = useState(null);
  const [topic, setTopic] = useState("");
  const [description, setDescription] = useState("");
  const [category, setCategory] = useState("");
  const [preview, setPreview] = useState([]);
  const [isUploading, setIsUploading] = useState(false);
  const [isUploaded, setIsUploaded] = useState(false);
  const [examDuration, setExamDuration] = useState(30);
  const [passPercentage, setPassPercentage] = useState(70);
  const [reattemptCount, setReattemptCount] = useState(0);
  const [totalQuestions, setTotalQuestions] = useState(0);
  const [showUploadedExams, setShowUploadedExams] = useState(false);
  const [allExams, setAllExams] = useState([]);
  const [examSearchTerm, setExamSearchTerm] = useState("");
  const [isExamSearchOpen, setIsExamSearchOpen] = useState(false);
  const [editingExamId, setEditingExamId] = useState(null);
  const [questionsToEdit, setQuestionsToEdit] = useState([]);

  const [selectedUserReport, setSelectedUserReport] = useState(null);
  const [isTestsVisible, setIsTestsVisible] = useState(false);
  const [reportCategoryFilter, setReportCategoryFilter] = useState("");

  const filterRef = useRef(null);
  const examSearchRef = useRef(null);
  const examSearchInputRef = useRef(null);
  const searchRef = useRef(null);

  const itemsPerPage = 5;

  const fetchInitialData = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const token = localStorage.getItem("token");
      const config = { headers: { Authorization: `Bearer ${token}` } };

      const storedName = localStorage.getItem("name");
      setManagerName(storedName || "Manager");

      const [scoresRes, categoriesRes, employeesRes, assessmentsRes] = await Promise.all([
        axios.get("https://localhost:5000/api/assessment/all-scores", config),
        axios.get("https://localhost:5000/api/Employees/getCategories", config),
        axios.get("https://localhost:5000/api/Employees", config),
        axios.get("https://localhost:5000/api/assessment/all-assessments", config),
      ]);

      const scoresWithKeys = scoresRes.data.map((exam, index) => ({
        ...exam,
        uniqueKey: `${exam.userEmail}-${exam.dateTaken}-${exam.assignmentName}-${index}`,
        passPercentage: exam.passPercentage,
      }));
      setAllScores(scoresWithKeys);
      calculateAverageScore(scoresWithKeys);
      getRecentExams(scoresWithKeys, 1);
      getCurrentScores(scoresWithKeys, 1);

      const filteredCategories = Array.isArray(categoriesRes.data)
        ? categoriesRes.data.filter((cat) => cat !== "Management")
        : [];
      filteredCategories.unshift("All");
      setCategories(filteredCategories);

      setEmployees(employeesRes.data);
      setAllExams(assessmentsRes.data);

      setTotalUsers(
        employeesRes.data.filter((emp) => emp.roleName !== "Admin" && emp.roleName !== "Manager").length
      );
      setTotalAssessments([...new Set(assessmentsRes.data.map((exam) => exam.assessmentId))].length);
    } catch (error) {
      console.error("Error fetching initial data:", error);
      setError("Failed to fetch initial data");
      toast.error("Failed to fetch initial data");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchInitialData();
  }, [fetchInitialData]);

  useEffect(() => {
    const handleScroll = () => {
      setShowScrollTop(window.scrollY > 200);
    };
    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (filterRef.current && !filterRef.current.contains(event.target)) {
        setShowFilterModal(false);
      }
      if (examSearchRef.current && !examSearchRef.current.contains(event.target)) {
        setIsExamSearchOpen(false);
      }
      if (searchRef.current && !searchRef.current.contains(event.target)) {
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  useEffect(() => {
    setIsTestsVisible(false);
  }, [selectedUserReport]);

  const calculateAverageScore = (scores) => {
    if (!scores || scores.length === 0) {
      setAverageScore(0);
      return;
    }
    const totalPercentage = scores.reduce((sum, score) => {
      const percentage = (score.score / score.totalQuestions) * 100;
      return sum + percentage;
    }, 0);
    setAverageScore((totalPercentage / scores.length).toFixed(2));
  };

  const getRecentExams = (scores, page) => {
    if (!scores || scores.length === 0) {
      setRecentExams([]);
      setTotalPagesHome(1);
      return;
    }

    const sortedScores = [...scores].sort((a, b) => new Date(b.dateTaken || 0) - new Date(a.dateTaken || 0));
    const startIndex = (page - 1) * itemsPerPage;
    const endIndex = Math.min(startIndex + itemsPerPage, sortedScores.length);

    const currentPageExams = sortedScores
      .slice(startIndex, endIndex)
      .map((exam, index) => ({
        ...exam,
        uniqueKey: `${exam.userEmail}-${exam.dateTaken}-${exam.assignmentName}-${startIndex + index}`,
      }));

    setRecentExams(currentPageExams);
    setTotalPagesHome(Math.ceil(sortedScores.length / itemsPerPage));
    setCurrentPageHome(page);
    setPageInputHome(page.toString());
  };

  const getCurrentScores = (scores, page) => {
    const startIndex = (page - 1) * itemsPerPage;
    const endIndex = Math.min(startIndex + itemsPerPage, scores.length);
    setCurrentScores(scores.slice(startIndex, endIndex));
    setTotalPagesScores(Math.ceil(scores.length / itemsPerPage));
    setCurrentPageScores(page);
    setPageInputScores(page.toString());
  };

  const filterScores = useCallback(
    ({
      scores = allScores,
      user = searchUser,
      assessment = searchUser,
      date = selectedDate,
      categories = selectedCategories,
      statuses = selectedStatuses,
      column = sortColumn,
      sort = sortOrder,
    } = {}) => {
      let filtered = [...scores];

      if (user || assessment) {
        const searchLower = (user || assessment).toLowerCase();
        filtered = filtered.filter(
          (score) =>
            (score.userName && score.userName.toLowerCase().includes(searchLower)) ||
            (score.userEmail && score.userEmail.toLowerCase().includes(searchLower)) ||
            (score.assignmentName && score.assignmentName.toLowerCase().includes(searchLower)) ||
            (score.description && score.description.toLowerCase().includes(searchLower))
        );
      }

      if (date) {
        filtered = filtered.filter((score) =>
          new Date(score.dateTaken).toISOString().split("T")[0] === date
        );
      }

      if (categories.length > 0 && !categories.includes("All")) {
        filtered = filtered.filter((score) =>
          categories.includes(score.category || "Uncategorized")
        );
      }

      if (statuses.length > 0) {
        filtered = filtered.filter((score) => {
          const percentage = (score.score / score.totalQuestions) * 100;
          const status = percentage >= (score.passPercentage || 70) ? "passed" : "failed";
          return statuses.includes(status);
        });
      }

      filtered.sort((a, b) => {
        if (column === "userName") {
          return sort === "asc"
            ? (a.userName || "").localeCompare(b.userName || "")
            : (b.userName || "").localeCompare(a.userName || "");
        } else if (column === "userEmail") {
          return sort === "asc"
            ? (a.userEmail || "").localeCompare(b.userEmail || "")
            : (b.userEmail || "").localeCompare(a.userEmail || "");
        } else if (column === "dateTaken") {
          const dateA = new Date(a.dateTaken || 0);
          const dateB = new Date(b.dateTaken || 0);
          return sort === "desc" ? dateB - dateA : dateA - dateB;
        }
        return 0;
      });

      getCurrentScores(filtered, 1);
    },
    [allScores, searchUser, selectedDate, selectedCategories, selectedStatuses, sortColumn, sortOrder]
  );

  useEffect(() => {
    filterScores();
  }, [searchUser, selectedDate, selectedCategories, selectedStatuses, allScores, filterScores]);

  const handleViewChange = (newView) => {
    setView(newView);
    setError(null);
    setIsSidebarOpen(false);
    if (newView === "scores") {
      setSearchUser("");
      setSelectedDate("");
      setSelectedCategories([]);
      setSelectedStatuses([]);
      setCategorySearch("");
      setSortColumn("dateTaken");
      setSortOrder("desc");
      filterScores({ scores: allScores });
    } else if (newView === "promote") {
      fetchEmployeesWithRoles();
      setEmployeeSearchTerm("");
    } else if (newView === "upload") {
      setShowUploadedExams(false);
      setExamSearchTerm("");
      setIsExamSearchOpen(false);
      setEditingExamId(null);
      setQuestionsToEdit([]);
    } else if (newView === "reports") {
      setReportCategoryFilter("");
      setSelectedUserReport(null);
    }
  };

  const toggleSidebar = () => {
    setIsSidebarOpen((prev) => !prev);
  };

  const scrollToTop = () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  };

  const handlePreviousPageHome = () => {
    if (currentPageHome > 1) {
      const newPage = currentPageHome - 1;
      getRecentExams(allScores, newPage);
    }
  };

  const handleNextPageHome = () => {
    if (currentPageHome < totalPagesHome) {
      const newPage = currentPageHome + 1;
      getRecentExams(allScores, newPage);
    }
  };

  const handlePageInputChangeHome = (e) => {
    setPageInputHome(e.target.value);
  };

  const handlePageSubmitHome = (e) => {
    e.preventDefault();
    const pageNum = parseInt(pageInputHome, 10);
    if (!isNaN(pageNum) && pageNum >= 1 && pageNum <= totalPagesHome) {
      getRecentExams(allScores, pageNum);
    } else {
      setPageInputHome(currentPageHome.toString());
      toast.error("Invalid page number");
    }
  };

  const handlePreviousPageScores = () => {
    if (currentPageScores > 1) {
      const newPage = currentPageScores - 1;
      getCurrentScores(allScores, newPage);
    }
  };

  const handleNextPageScores = () => {
    if (currentPageScores < totalPagesScores) {
      const newPage = currentPageScores + 1;
      getCurrentScores(allScores, newPage);
    }
  };

  const handlePageInputChangeScores = (e) => {
    setPageInputScores(e.target.value);
  };

  const handlePageSubmitScores = (e) => {
    e.preventDefault();
    const pageNum = parseInt(pageInputScores, 10);
    if (!isNaN(pageNum) && pageNum >= 1 && pageNum <= totalPagesScores) {
      getCurrentScores(allScores, pageNum);
    } else {
      setPageInputScores(currentPageScores.toString());
      toast.error("Invalid page number");
    }
  };

  const handleSort = (column) => {
    const newSortOrder = sortColumn === column && sortOrder === "asc" ? "desc" : "asc";
    setSortColumn(column);
    setSortOrder(newSortOrder);

    if (view === "scores") {
      filterScores({ column, sort: newSortOrder });
    } else if (view === "promote") {
      setEmployees((prevEmployees) => {
        const sortedEmployees = [...prevEmployees];
        sortedEmployees.sort((a, b) => {
          if (column === "username") {
            return newSortOrder === "asc"
              ? (a.username || "").localeCompare(b.username || "")
              : (b.username || "").localeCompare(a.username || "");
          } else if (column === "email") {
            return newSortOrder === "asc"
              ? (a.email || "").localeCompare(b.email || "")
              : (b.email || "").localeCompare(a.email || "");
          }
          return 0;
        });
        return sortedEmployees;
      });
    }
  };

  const fetchEmployeesWithRoles = async () => {
    setLoading(true);
    setError(null);
    try {
      const token = localStorage.getItem("token");
      const config = { headers: { Authorization: `Bearer ${token}` } };

      const [employeesRes, rolesRes] = await Promise.all([
        axios.get("https://localhost:5000/api/Employees", config),
        axios.get("https://localhost:5000/api/Employees/roles", config),
      ]);

      setEmployees(employeesRes.data);
      setRoles(rolesRes.data);

      const initialRoles = {};
      employeesRes.data.forEach((emp) => {
        initialRoles[emp.email] = emp.roleName || "";
      });
      setSelectedRole(initialRoles);
    } catch (error) {
      console.error("Error fetching employee data:", error);
      setError("Failed to fetch employees");
      toast.error("Failed to fetch employees");
    } finally {
      setLoading(false);
    }
  };

  const handleRoleChange = (email, roleName) => {
    setSelectedRole((prev) => ({ ...prev, [email]: roleName }));
  };

  const handleSubmitRoleChange = async (email) => {
    const roleName = selectedRole[email];
    if (!roleName) {
      toast.error("Please select a role");
      return;
    }
    setLoading(true);
    try {
      const response = await axios.put(
        "https://localhost:5000/api/Employees/submit",
        { Email: email, RoleName: roleName },
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      if (response.status === 204) {
        toast.success("Role updated successfully!");
        setEmployees((prev) =>
          prev.map((emp) => (emp.email === email ? { ...emp, roleName } : emp))
        );
      }
    } catch (error) {
      console.error("Error updating role:", error);
      toast.error(error.response?.data?.message || "Failed to update role");
    } finally {
      setLoading(false);
    }
  };

  const handleSubmit = async (email) => {
    const currentEmployee = employees.find((emp) => emp.email === email);
    const newRole = selectedRole[email];
    const currentRole = currentEmployee.roleName || "";

    if (newRole && newRole !== currentRole) {
      await handleSubmitRoleChange(email);
    }
    if (!newRole || newRole === currentRole) {
      toast.info("No changes detected. Please select a different role to update.");
    }
  };

  const handleFileChange = useCallback((e) => {
    const selectedFile = e.target.files[0];
    if (!selectedFile || selectedFile.type !== "text/csv") {
      toast.error("Please select a CSV file");
      return;
    }
    setFile(selectedFile);
    setIsUploaded(false);
    const reader = new FileReader();
    reader.onload = (event) => {
      const csvText = event.target.result;
      const rows = csvText.split("\n").map((row) => row.split(","));
      setPreview(rows);
      setTotalQuestions(rows.length - 1);
    };
    reader.readAsText(selectedFile);
  }, []);

  const handleUpload = useCallback(async () => {
    if (
      !file ||
      !topic.trim() ||
      !description.trim() ||
      !category ||
      examDuration < 1 ||
      passPercentage < 0 ||
      passPercentage > 100 ||
      reattemptCount < 0
    ) {
      toast.error("Please fill all required fields with valid values");
      return;
    }
    setIsUploading(true);
    const formData = new FormData();
    formData.append("file", file);
    formData.append("topic", topic);
    formData.append("description", description);
    formData.append("categoryName", category);
    formData.append("examDuration", examDuration);
    formData.append("passPercentage", passPercentage);
    formData.append("reattemptCount", reattemptCount);
    try {
      const response = await axios.post("https://localhost:5000/api/question-upload", formData, {
        headers: {
          "Content-Type": "multipart/form-data",
          Authorization: `Bearer ${localStorage.getItem("token")}`,
        },
      });
      if (response.status === 200) {
        toast.success("Questions uploaded successfully!");
        setIsUploaded(true);
        setTopic("");
        setDescription("");
        setCategory("");
        setFile(null);
        setExamDuration(30);
        setPassPercentage(70);
        setReattemptCount(0);
        setPreview([]);
        setTotalQuestions(0);
        document.getElementById("fileInput").value = "";
        fetchAllExams();
      }
    } catch (error) {
      console.error("Upload error:", error);
      toast.error(error.response?.data?.message || "Upload failed!");
    } finally {
      setIsUploading(false);
    }
  }, [file, topic, description, category, examDuration, passPercentage, reattemptCount]);

  const fetchAllExams = async () => {
    setLoading(true);
    try {
      const response = await axios.get("https://localhost:5000/api/assessment/all-assessments", {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      setAllExams(response.data);
    } catch (error) {
      console.error("Error fetching all exams:", error);
      toast.error("Failed to load exams");
      setAllExams([]);
    } finally {
      setLoading(false);
    }
  };

  const fetchQuestionsToEdit = async (examId) => {
    try {
      const response = await axios.get(`https://localhost:5000/api/assessment/EditAssessment/${examId}`, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      setQuestionsToEdit(response.data);
      setEditingExamId(examId);
    } catch (error) {
      console.error("Error fetching questions:", error);
      toast.error("Failed to load questions for editing");
    }
  };

  const saveEditedQuestions = async () => {
    if (!questionsToEdit || questionsToEdit.length === 0) {
      toast.error("No questions to save");
      return;
    }

    const formattedQuestions = questionsToEdit.map((q) => ({
      QuestionID: q.questionID || 0,
      ExamID: q.examID || editingExamId,
      QuestionText: q.questionText,
      OptionA: q.optionA,
      OptionB: q.optionB,
      OptionC: q.optionC,
      OptionD: q.optionD,
      CorrectAns: q.correctAns,
    }));

    try {
      const response = await axios.post(
        "https://localhost:5000/api/assessment/updateQuestions",
        formattedQuestions,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
            "Content-Type": "application/json",
          },
        }
      );
      toast.success(response.data.message);
      setEditingExamId(null);
      setQuestionsToEdit([]);
      await fetchAllExams();
    } catch (error) {
      console.error("Error updating questions:", error);
      toast.error(error.response?.data?.message || "Failed to update questions");
    }
  };

  const handleDeleteAssessment = async (assessmentId, e) => {
    e.stopPropagation();
    if (!window.confirm(`Are you sure you want to delete assessment ID ${assessmentId}?`)) return;
    try {
      const response = await axios.delete(`https://localhost:5000/api/assessment/deleteExam/${assessmentId}`, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      if (response.status === 200) {
        toast.success(response.data.message || "Assessment deleted successfully!");
        setAllExams((prev) => prev.filter((exam) => exam.assessmentId !== assessmentId));
      }
    } catch (error) {
      console.error("Error deleting assessment:", error);
      toast.error(error.response?.data?.message || "Failed to delete assessment");
    }
  };

  const isExamAttempted = (examId) => {
    return allScores.some((score) => score.assessmentID === examId);
  };

  const toggleExamSearch = () => {
    setIsExamSearchOpen((prev) => !prev);
    if (!isExamSearchOpen) setTimeout(() => examSearchInputRef.current?.focus(), 0);
  };

  const toggleUploadedExams = () => {
    setShowUploadedExams((prev) => !prev);
    if (!showUploadedExams) fetchAllExams();
    setEditingExamId(null);
    setQuestionsToEdit([]);
  };

  const generateUserReport = async (employeeId) => {
    if (!employeeId || isNaN(employeeId)) {
      toast.error("Invalid employee ID");
      console.error("Invalid employeeId:", employeeId);
      return;
    }
    try {
      setLoading(true);
      const token = localStorage.getItem("token");
      const [availableRes, completedRes] = await Promise.all([
        axios.get(`https://localhost:5000/api/assessment/user-assessments/${employeeId}`, {
          headers: { Authorization: `Bearer ${token}` },
        }),
        axios.get(`https://localhost:5000/api/assessment/completed-assessments/${employeeId}`, {
          headers: { Authorization: `Bearer ${token}` },
        }),
      ]);

      const availableTests = availableRes.data.availableTests || [];
      const completedTests = completedRes.data.completedTests || [];

      const avgScore =
        completedTests.length > 0
          ? (
              completedTests.reduce((sum, test) => sum + (test.score / test.totalQuestions) * 100, 0) /
              completedTests.length
            ).toFixed(2)
          : 0;
      const passRate =
        completedTests.length > 0
          ? (
              (completedTests.filter(
                (test) => (test.score / test.totalQuestions) * 100 >= (test.passingPercentage || 70)
              ).length / completedTests.length) * 100
            ).toFixed(2)
          : 0;

      const sortedCompletedTests = [...completedTests].sort(
        (a, b) => new Date(b.dateTaken) - new Date(a.dateTaken)
      );
      const topPerformed = sortedCompletedTests.reduce(
        (max, test) =>
          (test.score / test.totalQuestions) * 100 > (max.score / max.totalQuestions) * 100 ? test : max,
        sortedCompletedTests[0] || {}
      );
      const leastPerformed = sortedCompletedTests.reduce(
        (min, test) =>
          (test.score / test.totalQuestions) * 100 < (min.score / min.totalQuestions) * 100 ? test : min,
        sortedCompletedTests[0] || {}
      );

      setSelectedUserReport({
        employeeId,
        availableTests,
        completedTests: sortedCompletedTests,
        avgScore,
        passRate,
        topPerformed,
        leastPerformed,
      });
      toast.success("User report generated!");
    } catch (error) {
      console.error("Error generating user report:", error);
      toast.error(error.response?.data?.message || "Failed to generate report");
      setSelectedUserReport(null);
    } finally {
      setLoading(false);
    }
  };

  // Handle duration and pass percentage changes
  const handleSliderChange = useCallback((e) => setExamDuration(Number(e.target.value)), []);
  const handleDurationChange = useCallback((e) =>
    setExamDuration(Math.max(5, Math.min(120, Number(e.target.value)))), []);
  const handlePassPercentageChange = useCallback((e) =>
    setPassPercentage(Math.max(0, Math.min(100, Number(e.target.value)))), []);

  return (
    <div className="flex flex-col min-h-screen">
      <Navbar role="Manager" />
      <div className="flex flex-1 md:flex-row min-h-screen">
        <Sidebar
          view={view}
          handleViewChange={handleViewChange}
          isSidebarOpen={isSidebarOpen}
          toggleSidebar={toggleSidebar}
        />
        {isSidebarOpen && (
          <div
            className="fixed inset-0 bg-black bg-opacity-50 z-10 md:hidden"
            onClick={toggleSidebar}
          ></div>
        )}
        <div className="flex-1 p-6">
          <h1 className="text-3xl font-bold text-violet-600 mb-6 border-b-2 border-violet-300 pb-2">
            Manager Workspace
          </h1>
          {loading && <p className="text-gray-500">Loading...</p>}
          {error && <p className="text-red-500">{error}</p>}
          {view === "home" && !loading && (
            <HomeView
              managerName={managerName}
              timeOfDay={
                new Date().getHours() < 12
                  ? "Good morning"
                  : new Date().getHours() < 18
                  ? "Good afternoon"
                  : "Good evening"
              }
              averageScore={averageScore}
              totalUsers={totalUsers}
              totalAssessments={totalAssessments}
              recentExams={recentExams}
              currentPage={currentPageHome}
              totalPages={totalPagesHome}
              pageInput={pageInputHome}
              handlePreviousPage={handlePreviousPageHome}
              handleNextPage={handleNextPageHome}
              handlePageInputChange={handlePageInputChangeHome}
              handlePageSubmit={handlePageSubmitHome}
            />
          )}
          {view === "scores" && !loading && (
            <ScoresView
              currentScores={currentScores}
              searchUser={searchUser}
              setSearchUser={setSearchUser}
              selectedDate={selectedDate}
              setSelectedDate={setSelectedDate}
              categories={categories}
              selectedCategories={selectedCategories}
              setSelectedCategories={setSelectedCategories}
              selectedStatuses={selectedStatuses}
              setSelectedStatuses={setSelectedStatuses}
              categorySearch={categorySearch}
              setCategorySearch={setCategorySearch}
              showFilterModal={showFilterModal}
              setShowFilterModal={setShowFilterModal}
              sortColumn={sortColumn}
              sortOrder={sortOrder}
              handleSort={handleSort}
              currentPage={currentPageScores}
              totalPages={totalPagesScores}
              pageInput={pageInputScores}
              handlePreviousPage={handlePreviousPageScores}
              handleNextPage={handleNextPageScores}
              handlePageInputChange={handlePageInputChangeScores}
              handlePageSubmit={handlePageSubmitScores}
              filterRef={filterRef}
            />
          )}
          {view === "promote" && (
            <PromoteView
              employees={employees}
              employeeSearchTerm={employeeSearchTerm}
              setEmployeeSearchTerm={setEmployeeSearchTerm}
              selectedRole={selectedRole}
              roles={roles}
              loading={loading}
              handleSort={handleSort}
              sortColumn={sortColumn}
              sortOrder={sortOrder}
              handleRoleChange={handleRoleChange}
              handleSubmit={handleSubmit}
              searchRef={searchRef}
            />
          )}
          {view === "upload" && !loading && (
            <UploadView
              topic={topic}
              setTopic={setTopic}
              description={description}
              setDescription={setDescription}
              category={category}
              setCategory={setCategory}
              categories={categories}
              file={file}
              setFile={setFile}
              preview={preview}
              setPreview={setPreview}
              isUploading={isUploading}
              setIsUploading={setIsUploading}
              isUploaded={isUploaded}
              setIsUploaded={setIsUploaded}
              examDuration={examDuration}
              setExamDuration={setExamDuration}
              passPercentage={passPercentage}
              setPassPercentage={setPassPercentage}
              reattemptCount={reattemptCount}
              setReattemptCount={setReattemptCount}
              totalQuestions={totalQuestions}
              setTotalQuestions={setTotalQuestions}
              showUploadedExams={showUploadedExams}
              setShowUploadedExams={setShowUploadedExams}
              allExams={allExams}
              setAllExams={setAllExams}
              examSearchTerm={examSearchTerm}
              setExamSearchTerm={setExamSearchTerm}
              isExamSearchOpen={isExamSearchOpen}
              setIsExamSearchOpen={setIsExamSearchOpen}
              editingExamId={editingExamId}
              setEditingExamId={setEditingExamId}
              questionsToEdit={questionsToEdit}
              setQuestionsToEdit={setQuestionsToEdit}
              handleFileChange={handleFileChange}
              handleUpload={handleUpload}
              handleSliderChange={handleSliderChange}
              handleDurationChange={handleDurationChange}
              handlePassPercentageChange={handlePassPercentageChange}
              toggleUploadedExams={toggleUploadedExams}
              toggleExamSearch={toggleExamSearch}
              fetchQuestionsToEdit={fetchQuestionsToEdit}
              saveEditedQuestions={saveEditedQuestions}
              handleDeleteAssessment={handleDeleteAssessment}
              isExamAttempted={isExamAttempted}
              examSearchRef={examSearchRef}
              examSearchInputRef={examSearchInputRef}
              loading={loading}
            />
          )}
          {view === "reports" && !loading && (
            <ReportsView
              employees={employees}
              selectedUserReport={selectedUserReport}
              setSelectedUserReport={setSelectedUserReport}
              generateUserReport={generateUserReport}
              isTestsVisible={isTestsVisible}
              setIsTestsVisible={setIsTestsVisible}
              reportCategoryFilter={reportCategoryFilter}
              setReportCategoryFilter={setReportCategoryFilter}
              loading={loading}
            />
          )}
        </div>
      </div>
      {showScrollTop && (
        <button
          onClick={scrollToTop}
          className="fixed bottom-4 right-4 bg-blue-500 text-white p-2 rounded-full shadow-lg hover:bg-blue-700"
          aria-label="Scroll to top"
        >
          <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 15l7-7 7 7" />
          </svg>
        </button>
      )}
      <Footer />
    </div>
  );
};hÇ£file:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/pages/ManagerDashboard.jsxxkÄÅ%
