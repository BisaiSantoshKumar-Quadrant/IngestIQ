jsx"Ü≥@sainath-final/client/src/components/manager/RecentExamsTable.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontendRecentExamsTable(0?8PhÇ∞file:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/components/manager/RecentExamsTable.jsx"˘£0sainath-final/client/src/pages/UserDashboard.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontendhandlePageSubmit"UserDashboard(ı0˛8P`hÇ†file:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/pages/UserDashboard.jsx"Òõ(sainath-final/client/src/pages/dummy.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontendhandlePageInputChange"ManagerDashboard(Ç0Ñ8P`hÇòfile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/pages/dummy.jsx"ç¶3sainath-final/client/src/pages/ManagerDashboard.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontendhandlePageInputChangeScores"ManagerDashboard(Â0Á8P`hÇ£file:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/pages/ManagerDashboard.jsx"˚≥@sainath-final/client/src/components/manager/RecentExamsTable.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend(64-65)(@0A8PÇ∞file:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/components/manager/RecentExamsTable.jsx"Ó´8sainath-final/client/src/components/manager/HomeView.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontendHomeView(078PhÇ®file:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontend/sainath-final/client/src/components/manager/HomeView.jsx0:éÉ»PªÍ 0†8§@›J·èøò‚ÙºRèøÑπÿöZëc:\Users\BisaiSantoshKumar(Qu\OneDrive - Quadrant Resource LLC\Desktop\final_updated_frontend\sainath-final\client\src\pages\ManagerDashboard.jsxb¿Å¶3sainath-final/client/src/pages/ManagerDashboard.jsxofile:///c:/Users/BisaiSantoshKumar%28Qu/OneDrive%20-%20Quadrant%20Resource%20LLC/Desktop/final_updated_frontendManagerDashboard(0¸8PZ6
